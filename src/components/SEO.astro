---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  type = 'website',
  image,
  publishedTime,
  modifiedTime,
  author = 'Just Info',
  noindex = false,
} = Astro.props;

const siteName = 'Just Info';
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const fullTitle = `${title} — ${siteName}`;
const defaultImage = new URL('/images/og-default.jpg', siteUrl).href;
const absoluteImage = image ? new URL(image, siteUrl).href : defaultImage;
const pathname = Astro.url.pathname.replace(/^\\/+|\\/+$/g, '');
const isHome = pathname === '';
const isArticle = type === 'article';

const breadcrumbItems = isHome
  ? [{ name: siteName, url: siteUrl.href }]
  : isArticle
    ? [
        { name: siteName, url: siteUrl.href },
        { name: 'Artikel', url: new URL('/artikel/', siteUrl).href },
        { name: title, url: canonicalUrl },
      ]
    : [
        { name: siteName, url: siteUrl.href },
        { name: title, url: canonicalUrl },
      ];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
<link rel="canonical" href={canonicalUrl} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />

{isArticle && publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{isArticle && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl.href}#website`,
      name: siteName,
      url: siteUrl.href,
      inLanguage: 'id-ID',
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl.href}#organization`,
      name: siteName,
      url: siteUrl.href,
      logo: {
        '@type': 'ImageObject',
        url: new URL('/logo.svg', siteUrl).href,
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: fullTitle,
      description,
      isPartOf: { '@id': `${siteUrl.href}#website` },
      inLanguage: 'id-ID',
      ...(isArticle && publishedTime ? { datePublished: publishedTime.toISOString() } : {}),
      ...(isArticle && modifiedTime ? { dateModified: modifiedTime.toISOString() } : {}),
    },
    ...(isArticle
      ? [
          {
            '@type': 'Article',
            '@id': `${canonicalUrl}#article`,
            headline: title,
            description,
            url: canonicalUrl,
            mainEntityOfPage: { '@id': `${canonicalUrl}#webpage` },
            image: [absoluteImage],
            ...(publishedTime ? { datePublished: publishedTime.toISOString() } : {}),
            ...(modifiedTime ? { dateModified: modifiedTime.toISOString() } : {}),
            author: {
              '@type': 'Organization',
              name: author,
              url: siteUrl.href,
            },
            publisher: { '@id': `${siteUrl.href}#organization` },
          },
        ]
      : []),
    {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: item.url,
      })),
    },
  ],
})} />
