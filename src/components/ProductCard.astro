---
interface Props {
  name: string;
  image: string;
  description: string;
  url: string;
  category: string;
  type: 'physical' | 'digital';
}

const { name, image, description, url, category, type } = Astro.props;
const typeLabel = type === 'digital' ? 'Digital' : 'Fisik';
---

<article class="product-card">
  <div class="product-image-wrap">
    <img src={image} alt={name} loading="lazy" decoding="async" />
  </div>
  <div class="product-body">
    <div class="product-meta">
      <span>{typeLabel}</span>
      <span>{category}</span>
    </div>
    <h2>{name}</h2>
    <p>{description}</p>
    <a class="product-link" href={url} target="_blank" rel="sponsored noopener noreferrer">
      Lihat Produk <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .product-card{display:grid;grid-template-columns:minmax(220px,280px) 1fr;overflow:hidden;background:var(--surface);border:1px solid var(--border);border-radius:14px}
  .product-image-wrap{min-height:220px;background:var(--page-background)}
  .product-image-wrap img{display:block;width:100%;height:100%;min-height:220px;object-fit:cover}
  .product-body{display:flex;flex-direction:column;padding:26px 28px}
  .product-meta{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;font-family:Arial,sans-serif;font-size:.78rem;color:var(--muted)}
  .product-meta span{padding:4px 9px;border:1px solid var(--border);border-radius:999px}
  h2{margin:0 0 10px;color:var(--heading);font-size:1.45rem;line-height:1.25}
  p{margin:0;color:var(--text);font-size:1rem;line-height:1.7}
  .product-link{display:inline-flex;align-items:center;gap:7px;width:max-content;margin-top:20px;padding:10px 15px;border-radius:8px;background:var(--link);color:#fff!important;text-decoration:none!important;font-family:Arial,sans-serif;font-size:.9rem;font-weight:700}
  .product-link:hover{opacity:.9}
  @media(max-width:680px){.product-card{grid-template-columns:1fr}.product-image-wrap,.product-image-wrap img{min-height:190px;height:220px}.product-body{padding:22px}}
</style>
