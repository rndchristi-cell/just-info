---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} — Just Info`} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} — Just Info`} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#111827" />
    <title>{title} — Just Info</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Just Info — Beranda">
          <img src="/logo.svg" alt="JUST INFO — Just What You Need to Know" width="168" height="48" />
        </a>
        <nav aria-label="Navigasi utama">
          <a href="/">Beranda</a>
          <a href="/artikel/">Artikel</a>
          <a href="/tentang/">Tentang</a>
          <button class="theme-toggle" type="button" aria-label="Aktifkan mode gelap"><span class="theme-icon" aria-hidden="true">☾</span><span class="theme-label">Gelap</span></button>
        </nav>
      </div>
    </header>

    <main class="container page-main">
      <article class="page-content">
        <p class="eyebrow">JUST INFO</p>
        <h1>{title}</h1>
        <slot />
      </article>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>© 2026 Just Info</p>
        <nav aria-label="Tautan informasi situs" class="footer-nav">
          <a href="/tentang/">Tentang</a>
          <a href="/kontak/">Kontak</a>
          <a href="/kebijakan-privasi/">Kebijakan Privasi</a>
          <a href="/disclaimer/">Disclaimer</a>
          <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const button = document.querySelector('.theme-toggle');
        const icon = document.querySelector('.theme-icon');
        const label = document.querySelector('.theme-label');
        const update = () => {
          const dark = document.documentElement.classList.contains('dark');
          if (icon) icon.textContent = dark ? '☀' : '☾';
          if (label) label.textContent = dark ? 'Terang' : 'Gelap';
          button?.setAttribute('aria-label', dark ? 'Aktifkan mode terang' : 'Aktifkan mode gelap');
        };
        update();
        button?.addEventListener('click', () => {
          const dark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', dark ? 'dark' : 'light');
          update();
        });
      })();
    </script>
  </body>
</html>

<style>
  :global(:root){color-scheme:light;--page-background:#f7f8fa;--surface:#fff;--text:#1f2933;--heading:#111827;--muted:#667085;--border:#e5e7eb;--link:#2563eb;--footer:#111827;--footer-text:#fff}
  :global(html.dark){color-scheme:dark;--page-background:#111827;--surface:#1f2937;--text:#e5e7eb;--heading:#f9fafb;--muted:#aab4c3;--border:#374151;--link:#93c5fd;--footer:#030712;--footer-text:#e5e7eb}
  :global(*){box-sizing:border-box}:global(html){scroll-behavior:smooth}:global(body){min-height:100vh;margin:0;color:var(--text);background:var(--page-background);font-family:Georgia,'Times New Roman',serif}
  .container{width:100%;max-width:1120px;margin-inline:auto;padding-inline:clamp(24px,5vw,64px)}
  .site-header{background:var(--surface);border-bottom:1px solid var(--border)}.header-inner{display:flex;align-items:center;justify-content:space-between;min-height:72px;gap:24px}.brand{display:flex;align-items:center;width:168px;color:var(--heading);text-decoration:none}.brand img{display:block;width:168px;height:48px;object-fit:contain;color:var(--heading)}nav{display:flex;align-items:center;flex-wrap:wrap;gap:14px}nav a{color:var(--link);text-decoration:none;font-family:Arial,sans-serif}nav a:hover{text-decoration:underline}
  .page-main{padding-top:72px;padding-bottom:88px}.page-content{max-width:820px}.eyebrow{margin:0 0 12px;color:var(--link);font-family:Arial,sans-serif;font-size:.78rem;font-weight:700;letter-spacing:.14em}h1{margin:0 0 28px;color:var(--heading);font-size:clamp(2.4rem,6vw,4.5rem);line-height:1.05}.page-content :global(h2){margin:40px 0 14px;color:var(--heading);font-size:1.65rem;line-height:1.25}.page-content :global(h3){margin:30px 0 10px;color:var(--heading)}.page-content :global(p),.page-content :global(li){font-size:1.08rem;line-height:1.8}.page-content :global(a){color:var(--link)}.page-content :global(ul),.page-content :global(ol){padding-left:1.4rem}.page-content :global(li+li){margin-top:8px}.note{padding:18px 20px;border:1px solid var(--border);border-radius:10px;background:var(--surface);color:var(--muted);font-family:Arial,sans-serif;font-size:.95rem;line-height:1.6}
  .site-footer{padding:30px 0;background:var(--footer);color:var(--footer-text);font-family:Arial,sans-serif}.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:24px}.site-footer p{margin:0}.footer-nav{justify-content:flex-end}.footer-nav a{color:var(--footer-text);font-size:.85rem}.theme-toggle{display:inline-flex;align-items:center;gap:6px;padding:7px 10px;border:1px solid var(--border);border-radius:999px;background:var(--surface);color:var(--text);cursor:pointer;font-family:Arial,sans-serif;font-size:.8rem}.theme-toggle:hover{border-color:var(--link)}.theme-icon{font-size:1rem;line-height:1}.theme-label{white-space:nowrap}
  @media(max-width:720px){.header-inner,.footer-inner{align-items:flex-start;flex-direction:column;padding-top:18px;padding-bottom:18px}.page-main{padding-top:48px}.footer-nav{justify-content:flex-start}.brand{width:152px}.brand img{width:152px;height:auto}}
</style>
