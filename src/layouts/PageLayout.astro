---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <main class="container page-main">
    <article class="page-content">
      <p class="eyebrow">JUST INFO</p>
      <h1>{title}</h1>
      <slot />
    </article>
  </main>
</BaseLayout>

<style>
  .page-main{padding-top:72px;padding-bottom:88px}
  .page-content{max-width:820px}
  .eyebrow{margin:0 0 12px;color:var(--link);font-family:Arial,sans-serif;font-size:.78rem;font-weight:700;letter-spacing:.14em}
  h1{margin:0 0 28px;color:var(--heading);font-size:clamp(2.4rem,6vw,4.5rem);line-height:1.05}
  .page-content :global(h2){margin:40px 0 14px;color:var(--heading);font-size:1.65rem;line-height:1.25}
  .page-content :global(h3){margin:30px 0 10px;color:var(--heading)}
  .page-content :global(p),.page-content :global(li){font-size:1.08rem;line-height:1.8}
  .page-content :global(a){color:var(--link)}
  .page-content :global(ul),.page-content :global(ol){padding-left:1.4rem}
  .page-content :global(li+li){margin-top:8px}
  .note{padding:18px 20px;border:1px solid var(--border);border-radius:10px;background:var(--surface);color:var(--muted);font-family:Arial,sans-serif;font-size:.95rem;line-height:1.6}
  @media(max-width:720px){.page-main{padding-top:48px}}
</style>