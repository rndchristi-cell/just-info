---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const posts = await getCollection('blog');
const sortedPosts = posts
  .filter((post) => !post.data.noindex)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const formatDate = (date: Date) => new Intl.DateTimeFormat('id-ID', { dateStyle: 'long' }).format(date);
const getPostUrl = (id: string) => `/${id.replace(/\.md$/, '')}/`;
const categories = [...new Set(sortedPosts.map((post) => post.data.category).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'id'));
---

<PageLayout title="Semua Artikel" description="Kumpulan artikel, panduan, dan tips teknologi dari Just Info.">
  {sortedPosts.length === 0 ? (
    <p>Belum ada artikel.</p>
  ) : (
    <>
      <div class="article-tools">
        <label class="search-box">
          <span class="search-icon" aria-hidden="true">⌕</span>
          <span class="sr-only">Cari artikel</span>
          <input id="article-search" type="search" placeholder="Cari artikel..." autocomplete="off" />
        </label>

        <div class="category-nav" aria-label="Navigasi kategori artikel">
          <button class="category-filter is-active" type="button" data-category="all">Semua</button>
          {categories.map((category) => (
            <button class="category-filter" type="button" data-category={category}>{category}</button>
          ))}
        </div>
      </div>

      <p class="search-status" id="search-status" aria-live="polite"></p>

      <div class="article-list" id="article-list">
        {sortedPosts.map((post) => (
          <article
            class="article-item"
            data-title={post.data.title.toLowerCase()}
            data-description={post.data.description.toLowerCase()}
            data-category={post.data.category.toLowerCase()}
            data-tags={post.data.tags.join(' ').toLowerCase()}
          >
            <div class="meta"><span>{post.data.category}</span><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></div>
            <h2><a href={getPostUrl(post.id)}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
            <a class="read-more" href={getPostUrl(post.id)}>Baca artikel →</a>
          </article>
        ))}
      </div>

      <p class="no-results" id="no-results" hidden>Artikel yang Anda cari belum ditemukan.</p>
    </>
  )}
</PageLayout>

<script is:inline>
  (() => {
    const input = document.querySelector('#article-search');
    const buttons = [...document.querySelectorAll('.category-filter')];
    const items = [...document.querySelectorAll('.article-item')];
    const status = document.querySelector('#search-status');
    const noResults = document.querySelector('#no-results');
    let activeCategory = 'all';

    const normalize = (value) => value.toLowerCase().trim();

    const update = () => {
      const query = normalize(input?.value || '');
      let visible = 0;

      items.forEach((item) => {
        const category = item.dataset.category || '';
        const haystack = [item.dataset.title, item.dataset.description, item.dataset.category, item.dataset.tags].join(' ');
        const matchesCategory = activeCategory === 'all' || category === normalize(activeCategory);
        const matchesSearch = !query || haystack.includes(query);
        const show = matchesCategory && matchesSearch;
        item.hidden = !show;
        if (show) visible += 1;
      });

      if (status) status.textContent = query || activeCategory !== 'all' ? `${visible} artikel ditemukan` : '';
      if (noResults) noResults.hidden = visible !== 0;
    };

    input?.addEventListener('input', update);
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        activeCategory = button.dataset.category || 'all';
        buttons.forEach((item) => item.classList.toggle('is-active', item === button));
        update();
      });
    });
  })();
</script>

<style>
  .article-tools{display:grid;gap:18px;margin-bottom:18px}.search-box{position:relative;display:block}.search-box input{width:100%;padding:13px 16px 13px 44px;border:1px solid var(--border);border-radius:10px;background:var(--surface);color:var(--text);font:inherit;font-family:Arial,sans-serif;font-size:.95rem;outline:none}.search-box input::placeholder{color:var(--muted)}.search-box input:focus{border-color:var(--link);box-shadow:0 0 0 3px color-mix(in srgb,var(--link) 15%,transparent)}.search-icon{position:absolute;left:16px;top:50%;z-index:1;transform:translateY(-52%);color:var(--muted);font-family:Arial,sans-serif;font-size:1.5rem;line-height:1;pointer-events:none}.category-nav{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;scrollbar-width:thin}.category-filter{flex:0 0 auto;padding:8px 13px;border:1px solid var(--border);border-radius:999px;background:var(--surface);color:var(--muted);font-family:Arial,sans-serif;font-size:.82rem;cursor:pointer}.category-filter:hover,.category-filter.is-active{border-color:var(--link);color:var(--link)}.category-filter.is-active{font-weight:700}.search-status{min-height:1.2em;margin:0 0 14px;color:var(--muted);font-family:Arial,sans-serif;font-size:.82rem}.article-list{display:grid;gap:20px}.article-item{padding:24px;border:1px solid var(--border);border-radius:12px;background:var(--surface)}.article-item[hidden]{display:none}.article-item h2{margin:10px 0;color:var(--heading);font-size:1.6rem}.article-item h2 a{color:var(--heading);text-decoration:none}.article-item h2 a:hover,.read-more:hover{color:var(--link);text-decoration:underline}.article-item p{margin:0 0 12px;color:var(--muted)}.meta{display:flex;flex-wrap:wrap;gap:10px;color:var(--muted);font-family:Arial,sans-serif;font-size:.82rem}.read-more{color:var(--link);font-family:Arial,sans-serif;font-weight:700;text-decoration:none}.no-results{margin:20px 0;padding:24px;border:1px dashed var(--border);border-radius:12px;color:var(--muted);font-family:Arial,sans-serif}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
</style>
