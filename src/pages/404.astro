---
import SEO from '../components/SEO.astro';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#111827" />
    <SEO
      title="Halaman Tidak Ditemukan"
      description="Halaman yang Anda cari tidak ditemukan di Just Info."
      noindex={true}
    />
  </head>
  <body>
    <main class="error-page">
      <div class="error-card">
        <p class="code">404</p>
        <h1>Halaman tidak ditemukan</h1>
        <p>Maaf, halaman yang Anda cari mungkin sudah dipindahkan, dihapus, atau alamatnya tidak tepat.</p>
        <div class="actions">
          <a class="primary" href="/">Kembali ke Beranda</a>
          <a href="/artikel/">Lihat Artikel</a>
        </div>
      </div>
    </main>
  </body>
</html>

<style>
  :global(:root){color-scheme:light;--page-background:#f7f8fa;--surface:#fff;--text:#1f2933;--heading:#111827;--muted:#667085;--border:#e5e7eb;--link:#2563eb}
  :global(*){box-sizing:border-box}:global(body){min-height:100vh;margin:0;color:var(--text);background:var(--page-background);font-family:Georgia,'Times New Roman',serif}
  .error-page{min-height:100vh;display:grid;place-items:center;padding:32px}.error-card{width:min(100%,680px);padding:56px 40px;text-align:center;background:var(--surface);border:1px solid var(--border);border-radius:16px;box-shadow:0 12px 40px rgba(15,23,42,.08)}.code{margin:0;color:var(--link);font-family:Arial,sans-serif;font-size:clamp(4rem,14vw,7rem);font-weight:800;line-height:1}h1{margin:18px 0 12px;color:var(--heading);font-size:clamp(2rem,6vw,3.2rem);line-height:1.1}.error-card>p:not(.code){margin:0 auto;max-width:520px;color:var(--muted);font-family:Arial,sans-serif;font-size:1rem;line-height:1.7}.actions{display:flex;justify-content:center;flex-wrap:wrap;gap:12px;margin-top:30px}.actions a{padding:11px 16px;border-radius:9px;color:var(--link);font-family:Arial,sans-serif;text-decoration:none;border:1px solid var(--border)}.actions a:hover{text-decoration:underline}.actions .primary{color:#fff;background:#2563eb;border-color:#2563eb}
  @media(max-width:560px){.error-card{padding:42px 24px}}
</style>
