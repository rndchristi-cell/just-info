---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const allPosts = await getCollection('blog');
const sortedPosts = [...allPosts].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const currentIndex = sortedPosts.findIndex((item) => item.id === post.id);
const previousPost = currentIndex >= 0 ? sortedPosts[currentIndex + 1] : undefined;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : undefined;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('id-ID', { dateStyle: 'long' }).format(date);
const getPostUrl = (id: string) => `/${id.replace(/\.md$/, '')}/`;

const title = post.data.seoTitle?.trim() || post.data.title;
const description = post.data.seoDescription?.trim() || post.data.description;
const bannerPosition = post.data.bannerPosisi || 'atas';
const bannerUrl = post.data.bannerUrl?.trim();
const bannerImage = post.data.bannerImage?.trim();
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={bannerImage}
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
  author={post.data.author}
  noindex={post.data.noindex}
>
  <main class="container article-page">
    <a class="back-link" href="/artikel/">← Kembali ke semua artikel</a>

    <article>
      {bannerImage && bannerPosition === 'atas' && (
        <figure class="banner banner-atas">
          {bannerUrl ? (
            <a href={bannerUrl} target="_blank" rel="sponsored noopener noreferrer">
              <img src={bannerImage} alt={post.data.title} loading="eager" decoding="async" />
            </a>
          ) : (
            <img src={bannerImage} alt={post.data.title} loading="eager" decoding="async" />
          )}
          {bannerUrl && <figcaption class="affiliate-disclosure">Tautan pada banner ini mungkin merupakan tautan afiliasi. Just Info dapat menerima komisi tanpa biaya tambahan bagi Anda.</figcaption>}
        </figure>
      )}

      <header class="article-header">
        <div class="article-meta">
          <span class="category-badge">{post.data.category}</span>
          <time class="article-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          {post.data.updatedDate && <span class="article-date">· diperbarui {formatDate(post.data.updatedDate)}</span>}
        </div>
        <h1>{post.data.title}</h1>
        <p class="lead">{post.data.description}</p>
        {post.data.tags.length > 0 && (
          <div class="tag-list" aria-label="Tag artikel">
            {post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
          </div>
        )}
      </header>

      {bannerImage && bannerPosition === 'tengah' && (
        <figure class="banner banner-tengah">
          {bannerUrl ? (
            <a href={bannerUrl} target="_blank" rel="sponsored noopener noreferrer">
              <img src={bannerImage} alt={post.data.title} loading="eager" decoding="async" />
            </a>
          ) : (
            <img src={bannerImage} alt={post.data.title} loading="eager" decoding="async" />
          )}
          {bannerUrl && <figcaption class="affiliate-disclosure">Tautan pada banner ini mungkin merupakan tautan afiliasi. Just Info dapat menerima komisi tanpa biaya tambahan bagi Anda.</figcaption>}
        </figure>
      )}

      {bannerImage && bannerPosition === 'sidebar' ? (
        <div class="article-layout">
          <div class="prose"><Content /></div>
          <aside class="article-sidebar">
            <figure class="banner banner-sidebar">
              {bannerUrl ? (
                <a href={bannerUrl} target="_blank" rel="sponsored noopener noreferrer">
                  <img src={bannerImage} alt={post.data.title} loading="eager" decoding="async" />
                </a>
              ) : (
                <img src={bannerImage} alt={post.data.title} loading="eager" decoding="async" />
              )}
              {bannerUrl && <figcaption class="affiliate-disclosure">Tautan pada banner ini mungkin merupakan tautan afiliasi. Just Info dapat menerima komisi tanpa biaya tambahan bagi Anda.</figcaption>}
            </figure>
          </aside>
        </div>
      ) : (
        <div class="prose"><Content /></div>
      )}

      {(previousPost || nextPost) && (
        <nav class="article-navigation" aria-label="Navigasi artikel">
          {previousPost ? (
            <a class="article-nav-card" href={getPostUrl(previousPost.id)}>
              <span class="article-nav-label">← Baca artikel sebelumnya</span>
              <strong>{previousPost.data.title}</strong>
            </a>
          ) : <span aria-hidden="true"></span>}
          {nextPost ? (
            <a class="article-nav-card article-nav-next" href={getPostUrl(nextPost.id)}>
              <span class="article-nav-label">Baca artikel selanjutnya →</span>
              <strong>{nextPost.data.title}</strong>
            </a>
          ) : <span aria-hidden="true"></span>}
        </nav>
      )}
    </article>
  </main>

  <button class="back-to-top" type="button" aria-label="Kembali ke atas" title="Kembali ke atas">↑</button>

  <script slot="scripts" is:inline>
    (() => {
      const backToTop = document.querySelector('.back-to-top');
      const updateBackToTop = () => backToTop?.classList.toggle('is-visible', window.scrollY > 500);
      updateBackToTop();
      window.addEventListener('scroll', updateBackToTop, { passive: true });
      backToTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    })();
  </script>
</BaseLayout>

<style>
  .article-page{padding-top:64px;padding-bottom:88px}
  .back-link{display:inline-block;margin-bottom:40px;color:var(--link);text-decoration:none;font-family:Arial,sans-serif}
  .back-link:hover{text-decoration:underline}
  .article-header{max-width:820px}
  .article-meta{display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:14px}
  .category-badge{padding:5px 10px;border-radius:999px;background:var(--badge);color:var(--badge-text);font-family:Arial,sans-serif;font-size:.75rem;font-weight:700}
  .article-date{color:var(--muted);font-family:Arial,sans-serif;font-size:.85rem}
  .tag-list{display:flex;flex-wrap:wrap;gap:7px;margin:18px 0}
  .tag{color:var(--muted);font-family:Arial,sans-serif;font-size:.85rem}
  h1{margin:0 0 18px;color:var(--heading);font-size:clamp(2.4rem,6vw,4.5rem);line-height:1.05}
  .lead{margin:0;color:var(--muted);font-family:Arial,sans-serif;font-size:1.15rem;line-height:1.7}
  .banner{margin:36px 0}
  .banner img{display:block;width:100%;aspect-ratio:16 / 9;max-height:560px;object-fit:cover;border-radius:12px}
  .banner-atas img{object-position:top}
  .banner-tengah img{object-position:center}
  .banner-sidebar{margin:0}
  .banner-sidebar img{max-height:360px}
  .banner a{display:block}
  .affiliate-disclosure{margin:8px 0 0;color:var(--muted);font-family:Arial,sans-serif;font-size:.75rem;line-height:1.5}
  .article-layout{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:40px;align-items:start}
  .article-sidebar{min-width:0;position:sticky;top:24px}
  .prose{max-width:820px;font-size:1.15rem;line-height:1.85}
  .prose :global(h2){margin-top:42px;color:var(--heading);line-height:1.2}
  .prose :global(h3){color:var(--heading)}
  .prose :global(img){max-width:100%;height:auto;border-radius:8px}
  .prose :global(a){color:var(--link)}
  .prose :global(blockquote){margin-inline:0;padding-left:20px;border-left:3px solid var(--border);color:var(--muted)}
  .article-navigation{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-top:64px;padding-top:28px;border-top:1px solid var(--border)}
  .article-nav-card{display:flex;min-height:112px;flex-direction:column;justify-content:center;gap:8px;padding:18px 20px;background:var(--surface);border:1px solid var(--border);border-radius:12px;color:var(--heading);text-decoration:none}
  .article-nav-card:hover{border-color:var(--link)}
  .article-nav-next{text-align:right}
  .article-nav-label{color:var(--link);font-family:Arial,sans-serif;font-size:.78rem;font-weight:700}
  .article-nav-card strong{font-size:1.05rem;line-height:1.35}
  .back-to-top{position:fixed;right:24px;bottom:24px;z-index:20;width:44px;height:44px;border:1px solid var(--border);border-radius:50%;background:var(--surface);color:var(--heading);box-shadow:0 4px 16px rgba(0,0,0,.12);font-family:Arial,sans-serif;font-size:1.35rem;cursor:pointer;opacity:0;visibility:hidden;transform:translateY(10px);transition:opacity .2s ease,visibility .2s ease,transform .2s ease}
  .back-to-top.is-visible{opacity:1;visibility:visible;transform:translateY(0)}
  @media(max-width:900px){.article-layout{grid-template-columns:1fr}.article-sidebar{position:static}.article-sidebar .banner-sidebar{margin-top:36px}}
  @media(max-width:720px){.article-page{padding-top:40px}h1{font-size:clamp(2.2rem,11vw,3.4rem)}.article-navigation{grid-template-columns:1fr}.article-nav-next{text-align:left}}
</style>
