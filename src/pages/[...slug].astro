---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const formatDate = (date: Date) => new Intl.DateTimeFormat('id-ID', { dateStyle: 'long' }).format(date);
const getPostUrl = (id: string) => `/${id.replace(/\.md$/, '')}/`;
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const currentIndex = sortedPosts.findIndex((item) => item.id === post.id);
const previousPost = currentIndex >= 0 ? sortedPosts[currentIndex + 1] : undefined;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : undefined;
const bannerPosition = post.data.bannerPosisi || 'atas';
const bannerUrl = post.data.bannerUrl?.trim();
const bannerImage = post.data.bannerImage?.trim();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const absoluteBannerImage = bannerImage ? new URL(bannerImage, Astro.site).href : null;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={post.data.description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={post.data.title} />
    <meta property="og:description" content={post.data.description} />
    {absoluteBannerImage && <meta property="og:image" content={absoluteBannerImage} />}
    <meta name="twitter:card" content={absoluteBannerImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={post.data.title} />
    <meta name="twitter:description" content={post.data.description} />
    {absoluteBannerImage && <meta name="twitter:image" content={absoluteBannerImage} />}
    <title>{post.data.title} — Just Info</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Just Info — Beranda">
          <img src="/logo.svg" alt="JUST INFO — Just What You Need to Know" width="168" height="48" />
        </a>
        <nav aria-label="Navigasi utama">
          <a href="/">Beranda</a>
          <a href="/artikel/">Artikel</a>
          <a href="/tentang/">Tentang</a>
          <button class="theme-toggle" type="button" aria-label="Aktifkan mode gelap"><span class="theme-icon" aria-hidden="true">☾</span><span class="theme-label">Gelap</span></button>
        </nav>
      </div>
    </header>

    <main class="container article-page">
      <a class="back-link" href="/artikel/">← Kembali ke semua artikel</a>
      <article>
        {bannerImage && bannerPosition === 'atas' && (
          <figure class="banner banner-atas">
            {bannerUrl ? <a href={bannerUrl} target="_blank" rel="sponsored noopener noreferrer"><img src={bannerImage} alt={post.data.title} loading="eager" decoding="async" /></a> : <img src={bannerImage} alt={post.data.title} loading="eager" decoding="async" />}
            {bannerUrl && <figcaption class="affiliate-disclosure">Tautan pada banner ini mungkin merupakan tautan afiliasi. Just Info dapat menerima komisi tanpa biaya tambahan bagi Anda.</figcaption>}
          </figure>
        )}

        <header class="article-header">
          <div class="article-meta">
            <span class="category-badge">{post.data.category}</span>
            <time class="article-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          </div>
          <h1>{post.data.title}</h1>
          <p class="lead">{post.data.description}</p>
          {post.data.tags.length > 0 && <div class="tag-list" aria-label="Tag artikel">{post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}</div>}
        </header>

        {bannerImage && bannerPosition === 'tengah' && (
          <figure class="banner banner-tengah">
            {bannerUrl ? <a href={bannerUrl} target="_blank" rel="sponsored noopener noreferrer"><img src={bannerImage} alt={post.data.title} loading="eager" decoding="async" /></a> : <img src={bannerImage} alt={post.data.title} loading="eager" decoding="async" />}
            {bannerUrl && <figcaption class="affiliate-disclosure">Tautan pada banner ini mungkin merupakan tautan afiliasi. Just Info dapat menerima komisi tanpa biaya tambahan bagi Anda.</figcaption>}
          </figure>
        )}

        {bannerImage && bannerPosition === 'sidebar' ? (
          <div class="article-layout">
            <div class="prose"><Content /></div>
            <aside class="article-sidebar">
              <figure class="banner banner-sidebar">
                {bannerUrl ? <a href={bannerUrl} target="_blank" rel="sponsored noopener noreferrer"><img src={bannerImage} alt={post.data.title} loading="eager" decoding="async" /></a> : <img src={bannerImage} alt={post.data.title} loading="eager" decoding="async" />}
                {bannerUrl && <figcaption class="affiliate-disclosure">Tautan pada banner ini mungkin merupakan tautan afiliasi. Just Info dapat menerima komisi tanpa biaya tambahan bagi Anda.</figcaption>}
              </figure>
            </aside>
          </div>
        ) : (
          <div class="prose"><Content /></div>
        )}

        {(previousPost || nextPost) && (
          <nav class="article-navigation" aria-label="Navigasi artikel">
            {previousPost ? (
              <a class="article-nav-card article-nav-previous" href={getPostUrl(previousPost.id)}>
                <span class="article-nav-label">← Baca artikel sebelumnya</span>
                <strong>{previousPost.data.title}</strong>
              </a>
            ) : <span class="article-nav-spacer" aria-hidden="true"></span>}
            {nextPost ? (
              <a class="article-nav-card article-nav-next" href={getPostUrl(nextPost.id)}>
                <span class="article-nav-label">Baca artikel selanjutnya →</span>
                <strong>{nextPost.data.title}</strong>
              </a>
            ) : <span class="article-nav-spacer" aria-hidden="true"></span>}
          </nav>
        )}
      </article>
    </main>

    <button class="back-to-top" type="button" aria-label="Kembali ke atas" title="Kembali ke atas">↑</button>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>© 2026 Just Info</p>
        <nav aria-label="Tautan informasi situs" class="footer-nav">
          <a href="/tentang/">Tentang</a>
          <a href="/kontak/">Kontak</a>
          <a href="/kebijakan-privasi/">Kebijakan Privasi</a>
          <a href="/disclaimer/">Disclaimer</a>
          <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const button = document.querySelector('.theme-toggle');
        const icon = document.querySelector('.theme-icon');
        const label = document.querySelector('.theme-label');
        const update = () => {
          const dark = document.documentElement.classList.contains('dark');
          if (icon) icon.textContent = dark ? '☀' : '☾';
          if (label) label.textContent = dark ? 'Terang' : 'Gelap';
          button?.setAttribute('aria-label', dark ? 'Aktifkan mode terang' : 'Aktifkan mode gelap');
        };
        update();
        button?.addEventListener('click', () => {
          const dark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', dark ? 'dark' : 'light');
          update();
        });

        const backToTop = document.querySelector('.back-to-top');
        const updateBackToTop = () => {
          backToTop?.classList.toggle('is-visible', window.scrollY > 500);
        };
        updateBackToTop();
        window.addEventListener('scroll', updateBackToTop, { passive: true });
        backToTop?.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();
    </script>
  </body>
</html>

<style>
  :global(:root){color-scheme:light;--page-background:#f7f8fa;--surface:#fff;--text:#1f2933;--heading:#111827;--muted:#667085;--border:#e5e7eb;--link:#2563eb;--footer:#111827;--footer-text:#fff;--badge:#dbeafe;--badge-text:#1d4ed8}
  :global(html.dark){color-scheme:dark;--page-background:#111827;--surface:#1f2937;--text:#e5e7eb;--heading:#f9fafb;--muted:#aab4c3;--border:#374151;--link:#93c5fd;--footer:#030712;--footer-text:#e5e7eb;--badge:#1e3a8a;--badge-text:#bfdbfe}
  :global(*){box-sizing:border-box}:global(html){scroll-behavior:smooth}:global(body){margin:0;color:var(--text);background:var(--page-background);font-family:Georgia,'Times New Roman',serif}
  .container{width:100%;max-width:1120px;margin-inline:auto;padding-inline:clamp(24px,5vw,64px)}.site-header{position:sticky;top:0;z-index:50;background:var(--surface);border-bottom:1px solid var(--border);box-shadow:0 2px 12px rgba(15,23,42,.06);isolation:isolate}.header-inner{display:flex;align-items:center;justify-content:space-between;min-height:72px;gap:24px}.brand{display:flex;align-items:center;width:168px;text-decoration:none;color:var(--heading)}.brand img{display:block;width:168px;height:48px;object-fit:contain;color:var(--heading)}nav{display:flex;align-items:center;flex-wrap:wrap;gap:14px}nav a,.back-link{color:var(--link);text-decoration:none;font-family:Arial,sans-serif}nav a:hover,.back-link:hover{text-decoration:underline}
  .article-page{padding-top:64px;padding-bottom:88px}.back-link{display:inline-block;margin-bottom:40px}.article-header{max-width:820px}.article-meta{display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:14px}.category-badge{padding:5px 10px;border-radius:999px;background:var(--badge);color:var(--badge-text);font-family:Arial,sans-serif;font-size:.75rem;font-weight:700}.article-date{color:var(--muted);font-family:Arial,sans-serif;font-size:.85rem}.tag-list{display:flex;flex-wrap:wrap;gap:7px;margin:18px 0}.tag{color:var(--muted);font-family:Arial,sans-serif;font-size:.85rem}h1{margin:0 0 18px;color:var(--heading);font-size:clamp(2.4rem,6vw,4.5rem);line-height:1.05}.lead{margin:0;color:var(--muted);font-family:Arial,sans-serif;font-size:1.15rem;line-height:1.7}
  .banner{margin:36px 0}.banner img{display:block;width:100%;aspect-ratio:16 / 9;max-height:560px;object-fit:cover;border-radius:12px}.banner-atas img{object-position:top}.banner-tengah img{object-position:center}.banner-sidebar{margin:0}.banner-sidebar img{max-height:360px}.banner a{display:block}.affiliate-disclosure{margin:8px 0 0;color:var(--muted);font-family:Arial,sans-serif;font-size:.75rem;line-height:1.5}.article-layout{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:40px;align-items:start}.article-sidebar{min-width:0;position:sticky;top:24px}
  .prose{max-width:820px;font-size:1.15rem;line-height:1.85}.prose :global(h2){margin-top:42px;color:var(--heading);line-height:1.2}.prose :global(h3){color:var(--heading)}.prose :global(img){max-width:100%;height:auto;border-radius:8px}.prose :global(a){color:var(--link)}.prose :global(blockquote){margin-inline:0;padding-left:20px;border-left:3px solid var(--border);color:var(--muted)}
  .article-navigation{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-top:64px;padding-top:28px;border-top:1px solid var(--border)}.article-nav-card{display:flex;min-height:112px;flex-direction:column;justify-content:center;gap:8px;padding:18px 20px;background:var(--surface);border:1px solid var(--border);border-radius:12px;color:var(--heading);text-decoration:none}.article-nav-card:hover{border-color:var(--link)}.article-nav-next{text-align:right}.article-nav-label{color:var(--link);font-family:Arial,sans-serif;font-size:.78rem;font-weight:700}.article-nav-card strong{font-size:1.05rem;line-height:1.35}.article-nav-spacer{display:block}
  .site-footer{padding:28px 0;background:var(--footer);color:var(--footer-text);font-family:Arial,sans-serif}.site-footer p{margin:0}.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:24px}.footer-nav{justify-content:flex-end}.footer-nav a{color:var(--footer-text);font-size:.85rem}
  .theme-toggle{display:inline-flex;align-items:center;gap:6px;padding:7px 10px;border:1px solid var(--border);border-radius:999px;background:var(--surface);color:var(--text);cursor:pointer;font-family:Arial,sans-serif;font-size:.8rem}.theme-toggle:hover{border-color:var(--link)}.theme-icon{font-size:1rem;line-height:1}.theme-label{white-space:nowrap}
  .back-to-top{position:fixed;right:24px;bottom:24px;z-index:20;width:44px;height:44px;border:1px solid var(--border);border-radius:50%;background:var(--surface);color:var(--heading);box-shadow:0 4px 16px rgba(0,0,0,.12);font-family:Arial,sans-serif;font-size:1.35rem;line-height:1;cursor:pointer;opacity:0;visibility:hidden;transform:translateY(10px);transition:opacity .2s ease,visibility .2s ease,transform .2s ease}.back-to-top.is-visible{opacity:1;visibility:visible;transform:translateY(0)}.back-to-top:hover{border-color:var(--link)}.back-to-top:focus-visible{outline:3px solid var(--link);outline-offset:3px}
  @media(max-width:900px){.article-layout{grid-template-columns:1fr}.article-sidebar{position:static}.article-sidebar .banner-sidebar{margin-top:36px}}
  @media(max-width:720px){.header-inner,.footer-inner{align-items:flex-start;flex-direction:column}.footer-nav{justify-content:flex-start}.brand{width:152px}.brand img{width:152px;height:auto}.article-navigation{grid-template-columns:1fr}.article-nav-next{text-align:left}}
  @media(max-width:520px){.header-inner{padding-top:18px;padding-bottom:18px}.article-page{padding-top:40px}nav{width:100%;justify-content:flex-start}.back-to-top{right:16px;bottom:16px;width:42px;height:42px}}
</style>
