---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: {
      slug: post.id.replace(/\.md$/, ''),
    },
    props: {
      post,
    },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('id-ID', {
    dateStyle: 'long',
  }).format(date);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={post.data.description} />
    <title>{post.data.title} — Just Info</title>
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">Just Info</a>
        <nav aria-label="Navigasi utama">
          <a href="/">Beranda</a>
        </nav>
      </div>
    </header>

    <main class="container article-page">
      <a class="back-link" href="/">← Kembali ke artikel</a>

      <p class="article-date">{formatDate(post.data.pubDate)}</p>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>

      {post.data.bannerImage ? (
        <img
          class="hero-image"
          src={post.data.bannerImage}
          alt={post.data.title}
        />
      ) : null}

      <article class="prose">
        <Content />
      </article>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© 2026 Just Info</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    color: #1f2933;
    background: #f7f8fa;
    font-family: Georgia, 'Times New Roman', serif;
  }

  .container {
    width: min(820px, calc(100% - 32px));
    margin: 0 auto;
  }

  .site-header {
    background: #ffffff;
    border-bottom: 1px solid #e5e7eb;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(1120px, calc(100% - 32px));
    min-height: 72px;
    gap: 24px;
  }

  .brand {
    color: #111827;
    font-size: 1.35rem;
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 18px;
  }

  nav a,
  .back-link {
    color: #2563eb;
    text-decoration: none;
    font-family: Arial, sans-serif;
  }

  nav a:hover,
  .back-link:hover {
    text-decoration: underline;
  }

  .article-page {
    padding-top: 64px;
    padding-bottom: 88px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 48px;
  }

  .article-date {
    color: #667085;
    font-family: Arial, sans-serif;
    font-size: 0.9rem;
  }

  h1 {
    margin: 10px 0 18px;
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    line-height: 1.05;
  }

  .lead {
    color: #667085;
    font-family: Arial, sans-serif;
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .hero-image {
    width: 100%;
    max-height: 520px;
    margin: 36px 0;
    border-radius: 12px;
    object-fit: cover;
  }

  .prose {
    font-size: 1.15rem;
    line-height: 1.85;
  }

  .prose :global(h2) {
    margin-top: 42px;
    line-height: 1.2;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
  }

  .prose :global(a) {
    color: #2563eb;
  }

  .site-footer {
    padding: 28px 0;
    background: #111827;
    color: #ffffff;
    font-family: Arial, sans-serif;
  }
</style>
