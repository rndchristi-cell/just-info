---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

const sortedPosts = posts.sort(
  (a, b) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('id-ID', {
    dateStyle: 'long',
  }).format(date);

const getPostUrl = (id: string) => {
  const slug = id.replace(/\.md$/, '');
  return `/blog/${slug}/`;
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Just Info — artikel dan informasi pilihan."
    />
    <title>Just Info</title>
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">Just Info</a>
        <nav aria-label="Navigasi utama">
          <a href="/">Beranda</a>
          <a href="/admin/">Admin</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero container">
        <p class="eyebrow">BLOG</p>
        <h1>Informasi yang berguna untuk Anda.</h1>
        <p class="hero-description">
          Baca artikel terbaru dari Just Info.
        </p>
      </section>

      <section class="container articles-section" aria-labelledby="artikel-terbaru">
        <div class="section-heading">
          <h2 id="artikel-terbaru">Artikel terbaru</h2>
          <span>{sortedPosts.length} artikel</span>
        </div>

        {sortedPosts.length === 0 ? (
          <p class="empty-state">
            Belum ada artikel. Buat artikel pertama melalui dashboard admin.
          </p>
        ) : (
          <div class="article-grid">
            {sortedPosts.map((post) => (
              <article class="article-card">
                {post.data.bannerImage ? (
                  <img
                    src={post.data.bannerImage}
                    alt={post.data.title}
                    loading="lazy"
                  />
                ) : null}

                <div class="article-card-content">
                  <p class="article-date">
                    {formatDate(post.data.pubDate)}
                  </p>
                  <h3>
                    <a href={getPostUrl(post.id)}>{post.data.title}</a>
                  </h3>
                  <p>{post.data.description}</p>
                  <a class="read-more" href={getPostUrl(post.id)}>
                    Baca artikel →
                  </a>
                </div>
              </article>
            ))}
          </div>
        )}
      </section>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© 2026 Just Info</p>
      </div>
    </footer>
  </body>
</html>

