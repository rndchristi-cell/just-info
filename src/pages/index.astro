---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPosts = sortedPosts.slice(0, 5);
const formatDate = (date: Date) => new Intl.DateTimeFormat('id-ID', { dateStyle: 'long' }).format(date);
const getPostUrl = (id: string) => `/${id.replace(/\.md$/, '')}/`;
---

<BaseLayout
  title="Panduan teknologi dan informasi umum"
  description="Informasi, panduan, dan tips praktis tentang teknologi, pengetahuan umum"
>
  <main>
    <section class="hero container">
      <p class="eyebrow">JUST INFO</p>
      <h1>Panduan teknologi dan informasi umum.</h1>
      <p class="hero-description">Informasi, panduan, dan tips praktis seputar teknologi dan infromasi umum.</p>
    </section>

    <section class="container articles-section" aria-labelledby="artikel-terbaru">
      <div class="section-heading">
        <div><h2 id="artikel-terbaru">Artikel terbaru</h2><p>Beberapa artikel terbaru dari Just Info.</p></div>
        <span>{sortedPosts.length} artikel</span>
      </div>
      {latestPosts.length === 0 ? (
        <p class="empty-state">Belum ada artikel.</p>
      ) : (
        <>
          <div class="article-grid">
            {latestPosts.map((post) => (
              <article class="article-card">
                {post.data.bannerImage && <a class="card-image" href={getPostUrl(post.id)} aria-label={`Baca ${post.data.title}`}><img src={post.data.bannerImage} alt="" loading="lazy" decoding="async" /></a>}
                <div class="article-card-content">
                  <div class="article-meta"><span class="category-badge">{post.data.category}</span><time class="article-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></div>
                  <h3><a href={getPostUrl(post.id)}>{post.data.title}</a></h3>
                  <p class="article-description">{post.data.description}</p>
                  <a class="read-more" href={getPostUrl(post.id)}>Baca artikel <span aria-hidden="true">→</span></a>
                </div>
              </article>
            ))}
          </div>
          {sortedPosts.length > 5 && <div class="all-articles"><a class="all-articles-link" href="/artikel/">Lihat semua artikel <span aria-hidden="true">→</span></a></div>}
        </>
      )}
    </section>
  </main>

  <SocialLinks slot="footer-extra" />
</BaseLayout>

<style>
  .hero{padding-top:88px;padding-bottom:56px}
  .eyebrow{margin:0 0 12px;color:var(--link);font-family:Arial,sans-serif;font-size:.78rem;font-weight:700;letter-spacing:.14em}
  h1,h2,h3,p{margin-top:0}
  h1{max-width:720px;margin-bottom:18px;color:var(--heading);font-size:clamp(2.4rem,6vw,4.8rem);line-height:1}
  .hero-description{max-width:620px;margin:0;color:var(--muted);font-family:Arial,sans-serif;font-size:1.1rem;line-height:1.7}
  .articles-section{padding-bottom:80px}
  .section-heading{display:flex;align-items:baseline;justify-content:space-between;gap:20px;margin-bottom:20px}
  .section-heading h2{margin-bottom:6px;color:var(--heading)}
  .section-heading p{margin:0;color:var(--muted);font-family:Arial,sans-serif;font-size:.9rem}
  .section-heading>span{color:var(--muted);font-family:Arial,sans-serif;font-size:.85rem}
  .article-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
  .article-card{overflow:hidden;background:var(--surface);border:1px solid var(--border);border-radius:12px}
  .card-image{display:block;overflow:hidden}
  .article-card img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover;transition:transform 180ms ease}
  .card-image:hover img{transform:scale(1.02)}
  .article-card-content{padding:24px}
  .article-meta{display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:14px}
  .category-badge{padding:5px 10px;border-radius:999px;background:var(--badge);color:var(--badge-text);font-family:Arial,sans-serif;font-size:.75rem;font-weight:700}
  .article-card h3{margin-bottom:10px;font-size:1.45rem;line-height:1.2}
  .article-card h3 a{color:var(--heading);text-decoration:none}
  .article-card h3 a:hover{color:var(--link)}
  .article-description{color:var(--muted);font-family:Arial,sans-serif;line-height:1.6}
  .read-more{color:var(--link);text-decoration:none;font-family:Arial,sans-serif;display:inline-block;margin-top:4px;font-weight:700}
  .read-more:hover{text-decoration:underline}
  .all-articles{text-align:center;margin-top:36px}
  .all-articles-link{display:inline-block;padding:10px 16px;border:1px solid var(--border);border-radius:999px;font-weight:700;background:var(--surface);color:var(--link);text-decoration:none;font-family:Arial,sans-serif}
  .all-articles-link:hover{border-color:var(--link);text-decoration:underline}
  .empty-state{padding:32px;background:var(--surface);border:1px dashed var(--border);font-family:Arial,sans-serif;line-height:1.6}
  @media(max-width:800px){.article-grid{grid-template-columns:1fr}.hero{padding-top:60px;padding-bottom:40px}}
  @media(max-width:520px){.section-heading{align-items:flex-start;flex-direction:column;gap:6px}}
</style>
