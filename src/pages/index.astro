---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const formatDate = (date: Date) => new Intl.DateTimeFormat('id-ID', { dateStyle: 'long' }).format(date);
const getPostUrl = (id: string) => `/${id.replace(/\.md$/, '')}/`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Just Info — panduan teknologi yang mudah dipahami, dengan informasi praktis seputar hosting, website, WordPress, dan teknologi lainnya." />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content="Just Info — Panduan teknologi yang mudah dipahami" />
    <meta property="og:description" content="Informasi, panduan, dan tips praktis seputar hosting, website, WordPress, dan teknologi untuk membantu Anda memahami dan menggunakannya dengan lebih mudah." />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Just Info — Panduan teknologi yang mudah dipahami" />
    <meta name="twitter:description" content="Informasi, panduan, dan tips praktis seputar hosting, website, WordPress, dan teknologi untuk membantu Anda memahami dan menggunakannya dengan lebih mudah." />
    <meta name="theme-color" content="#111827" />
    <title>Just Info — Panduan teknologi yang mudah dipahami</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">Just Info</a>
        <nav aria-label="Navigasi utama">
          <a href="/" aria-current="page">Beranda</a>
          <button class="theme-toggle" type="button" aria-label="Aktifkan mode gelap"><span class="theme-icon" aria-hidden="true">☾</span><span class="theme-label">Gelap</span></button>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero container">
        <p class="eyebrow">JUST INFO</p>
        <h1>Panduan teknologi yang mudah dipahami.</h1>
        <p class="hero-description">Informasi, panduan, dan tips praktis seputar hosting, website, WordPress, dan teknologi untuk membantu Anda memahami dan menggunakannya dengan lebih mudah.</p>
      </section>

      <section class="container articles-section" aria-labelledby="artikel-terbaru">
        <div class="section-heading"><h2 id="artikel-terbaru">Artikel terbaru</h2><span>{sortedPosts.length} artikel</span></div>
        {sortedPosts.length === 0 ? (
          <p class="empty-state">Belum ada artikel.</p>
        ) : (
          <div class="article-grid">
            {sortedPosts.map((post) => (
              <article class="article-card">
                {post.data.bannerImage && <a class="card-image" href={getPostUrl(post.id)} aria-label={`Baca ${post.data.title}`}><img src={post.data.bannerImage} alt="" loading="lazy" decoding="async" /></a>}
                <div class="article-card-content">
                  <div class="article-meta"><span class="category-badge">{post.data.category}</span><time class="article-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></div>
                  <h3><a href={getPostUrl(post.id)}>{post.data.title}</a></h3>
                  <p class="article-description">{post.data.description}</p>
                  <a class="read-more" href={getPostUrl(post.id)}>Baca artikel <span aria-hidden="true">→</span></a>
                </div>
              </article>
            ))}
          </div>
        )}
      </section>
    </main>

    <footer class="site-footer"><div class="container"><p>© 2026 Just Info</p></div></footer>

    <script is:inline>
      (() => {
        const button = document.querySelector('.theme-toggle');
        const icon = document.querySelector('.theme-icon');
        const label = document.querySelector('.theme-label');
        const update = () => {
          const dark = document.documentElement.classList.contains('dark');
          if (icon) icon.textContent = dark ? '☀' : '☾';
          if (label) label.textContent = dark ? 'Terang' : 'Gelap';
          button?.setAttribute('aria-label', dark ? 'Aktifkan mode terang' : 'Aktifkan mode gelap');
        };
        update();
        button?.addEventListener('click', () => {
          const dark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', dark ? 'dark' : 'light');
          update();
        });
      })();
    </script>
  </body>
</html>

<style>
  :global(:root){color-scheme:light;--page-background:#f7f8fa;--surface:#fff;--text:#1f2933;--heading:#111827;--muted:#667085;--border:#e5e7eb;--link:#2563eb;--footer:#111827;--footer-text:#fff;--badge:#dbeafe;--badge-text:#1d4ed8}
  :global(html.dark){color-scheme:dark;--page-background:#111827;--surface:#1f2937;--text:#e5e7eb;--heading:#f9fafb;--muted:#aab4c3;--border:#374151;--link:#93c5fd;--footer:#030712;--footer-text:#e5e7eb;--badge:#1e3a8a;--badge-text:#bfdbfe}
  :global(*){box-sizing:border-box}:global(body){margin:0;color:var(--text);background:var(--page-background);font-family:Georgia,'Times New Roman',serif}
  .container{width:100%;max-width:1120px;margin-inline:auto;padding-inline:clamp(24px,5vw,64px)}
  .site-header{background:var(--surface);border-bottom:1px solid var(--border)}.header-inner{display:flex;align-items:center;justify-content:space-between;min-height:72px;gap:24px}.brand{color:var(--heading);font-size:1.5rem;font-weight:700;text-decoration:none}nav{display:flex;align-items:center;flex-wrap:wrap;gap:14px}nav a,.read-more{color:var(--link);text-decoration:none;font-family:Arial,sans-serif}nav a:hover,.read-more:hover{text-decoration:underline}
  .hero{padding-top:88px;padding-bottom:56px}.eyebrow{margin:0 0 12px;color:var(--link);font-family:Arial,sans-serif;font-size:.78rem;font-weight:700;letter-spacing:.14em}h1,h2,h3,p{margin-top:0}h1{max-width:720px;margin-bottom:18px;color:var(--heading);font-size:clamp(2.4rem,6vw,4.8rem);line-height:1}.hero-description{max-width:620px;margin:0;color:var(--muted);font-family:Arial,sans-serif;font-size:1.1rem;line-height:1.7}
  .articles-section{padding-bottom:80px}.section-heading{display:flex;align-items:baseline;justify-content:space-between;gap:20px;margin-bottom:20px}.section-heading h2{color:var(--heading)}.section-heading span,.article-date{color:var(--muted);font-family:Arial,sans-serif;font-size:.85rem}.article-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.article-card{overflow:hidden;background:var(--surface);border:1px solid var(--border);border-radius:12px}.card-image{display:block;overflow:hidden}.article-card img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover;transition:transform 180ms ease}.card-image:hover img{transform:scale(1.02)}.article-card-content{padding:24px}.article-meta{display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:14px}.category-badge{padding:5px 10px;border-radius:999px;background:var(--badge);color:var(--badge-text);font-family:Arial,sans-serif;font-size:.75rem;font-weight:700}.article-card h3{margin-bottom:10px;font-size:1.45rem;line-height:1.2}.article-card h3 a{color:var(--heading);text-decoration:none}.article-card h3 a:hover{color:var(--link)}.article-description{color:var(--muted);font-family:Arial,sans-serif;line-height:1.6}.read-more{display:inline-block;margin-top:4px;font-weight:700}.empty-state{padding:32px;background:var(--surface);border:1px dashed var(--border);font-family:Arial,sans-serif;line-height:1.6}.site-footer{padding:28px 0;background:var(--footer);color:var(--footer-text);font-family:Arial,sans-serif}.site-footer p{margin:0}
  .theme-toggle{display:inline-flex;align-items:center;gap:6px;padding:7px 10px;border:1px solid var(--border);border-radius:999px;background:var(--surface);color:var(--text);cursor:pointer;font-family:Arial,sans-serif;font-size:.8rem}.theme-toggle:hover{border-color:var(--link)}.theme-icon{font-size:1rem;line-height:1}.theme-label{white-space:nowrap}
  @media(max-width:800px){.article-grid{grid-template-columns:1fr}.hero{padding-top:60px;padding-bottom:40px}}
  @media(max-width:520px){.header-inner{align-items:flex-start;flex-direction:column;padding-top:18px;padding-bottom:18px}nav{width:100%;justify-content:flex-start}.section-heading{align-items:flex-start;flex-direction:column;gap:6px}}
</style>
